<!DOCTYPE html>
<!--
  LearningOS graph viewer template — static HTML shell only.
  graphs/render.py substitutes:
    {{TITLE}}            page and heading text, HTML-escaped
    {{KIND}}             graph kind
    {{SUBJECT_IDS}}      comma-separated subject ids
    {{GENERATED_AT}}     ISO-8601 UTC timestamp from the artefact
    {{NODE_COUNT}}       number of nodes
    {{EDGE_COUNT}}       number of edges
    {{MERMAID_SOURCE}}   the .mmd text, HTML-escaped, inside <pre class="mermaid">
    {{LEGEND_ROWS}}      one <tr><th>key</th><td>label</td></tr> per legend entry
    {{RENDERER_BLOCK}}   either an inlined <script> containing vendor/mermaid.min.js plus its
                         initialisation, or the "no renderer" notice below. Never a CDN <script
                         src>: this page must work with no network access.
  The page is a learning artefact, not an application: no network requests, no analytics, no
  external fonts. If nothing renders, the Mermaid source is still readable on the page.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}} — LearningOS</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 60rem;
    padding: 1.5rem;
  }
  h1 { font-size: 1.4rem; margin-bottom: 0.25rem; }
  .meta { font-size: 0.85rem; opacity: 0.8; margin-bottom: 1.5rem; }
  .meta dt { font-weight: 600; float: left; margin-right: 0.4rem; }
  .meta dd { margin: 0 0 0.2rem 0; }
  .notice {
    border: 2px solid currentColor;
    border-radius: 4px;
    font-size: 0.9rem;
    margin: 1rem 0;
    padding: 0.75rem 1rem;
  }
  .notice h2 { font-size: 1rem; margin-top: 0; }
  pre.mermaid {
    border: 1px solid rgba(128, 128, 128, 0.5);
    border-radius: 4px;
    overflow-x: auto;
    padding: 1rem;
    white-space: pre;
  }
  table { border-collapse: collapse; font-size: 0.9rem; margin: 1rem 0; }
  caption { font-weight: 600; text-align: left; padding-bottom: 0.4rem; }
  th, td { border: 1px solid rgba(128, 128, 128, 0.5); padding: 0.3rem 0.6rem; text-align: left; }
  footer { font-size: 0.8rem; margin-top: 2rem; opacity: 0.8; }
  code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; }
</style>
</head>
<body>
<main>
  <h1>{{TITLE}}</h1>
  <dl class="meta">
    <dt>Kind</dt><dd>{{KIND}}</dd>
    <dt>Subjects</dt><dd>{{SUBJECT_IDS}}</dd>
    <dt>Generated</dt><dd>{{GENERATED_AT}}</dd>
    <dt>Size</dt><dd>{{NODE_COUNT}} nodes, {{EDGE_COUNT}} edges</dd>
  </dl>

  <table>
    <caption>Legend</caption>
    <thead><tr><th scope="col">Key</th><th scope="col">Meaning</th></tr></thead>
    <tbody>
{{LEGEND_ROWS}}
    </tbody>
  </table>

  <h2>Diagram</h2>
  <pre class="mermaid">{{MERMAID_SOURCE}}</pre>

{{RENDERER_BLOCK}}

  <!-- Substituted into {{RENDERER_BLOCK}} when no vendored renderer is present:
  <section class="notice">
    <h2>Diagram not rendered</h2>
    <p>The Mermaid source above is the artefact; rendering it as a picture is optional. Two ways to
      get a rendered diagram, both local and both one-off:</p>
    <ol>
      <li>Place <code>mermaid.min.js</code> in <code>graphs/vendor/</code> under the tools
        directory, then regenerate. The file is then inlined into this page, which keeps it
        self-contained and offline.</li>
      <li>Install mermaid-cli so that <code>mmdc</code> is on PATH, then regenerate with
        <code>--format mmd,html,svg</code> to get an <code>.svg</code> beside this file.</li>
    </ol>
    <p>Neither is required. Nothing is downloaded automatically.</p>
  </section>
  -->
</main>
<footer>
  <p>Generated by LearningOS from local memory files. Regenerate with
    <code>python learningos.py update-graphs</code>. This page makes no network requests; deleting
    it is safe, as graph artefacts are derived and reproducible.</p>
</footer>
</body>
</html>
