%% LearningOS graph template — kind: learner_mastery
%% Static frame only. Node, edge, legend and class-assignment lines are generated from the graph
%% artefact JSON by graphs/mermaid.py. Placeholders:
%%   {{TITLE}}         graph title
%%   {{GENERATED_AT}}  ISO-8601 UTC timestamp from the artefact
%%   {{SUBJECT_IDS}}   comma-separated subject ids
%%   {{NODES}}         node lines, sorted, each with its status class applied
%%   {{EDGES}}         prerequisite edge lines, sorted
%%   {{LEGEND}}        legend node lines built from artefact["legend"], inside the Legend subgraph
%% One classDef per status. Status is ALSO written into each node label and into the legend text:
%% meaning is never carried by colour alone, so the graph survives greyscale printing and
%% colour-blind readers.
%% title: {{TITLE}}
%% generated_at: {{GENERATED_AT}}
%% subjects: {{SUBJECT_IDS}}
flowchart TD
  classDef unassessed fill:#ffffff,stroke:#777777,stroke-width:1px,color:#000000;
  classDef developing fill:#fdf3d0,stroke:#8a6d1a,stroke-width:1px,color:#000000;
  classDef practising fill:#dceaf7,stroke:#1f4e79,stroke-width:1px,color:#000000;
  classDef provisionally_mastered fill:#dff0d8,stroke:#2d6a2d,stroke-width:2px,color:#000000;
  classDef needs_review fill:#f8d7da,stroke:#8b1c24,stroke-width:2px,color:#000000;
  classDef legend fill:#ffffff,stroke:#333333,stroke-width:1px,color:#000000;
{{NODES}}
{{EDGES}}
  subgraph Legend["Legend (text labels, not colour)"]
    direction TB
{{LEGEND}}
  end
