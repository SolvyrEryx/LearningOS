{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learningos.local/schemas/concept_graph.schema.json",
  "title": "Concept graph",
  "description": "03_MEMORY/subjects/<subject_id>/concept_graph.json — the per-subject source of truth for edges between concepts. Graph artefacts under 03_MEMORY/graphs/ are derived from this file and never the other way round. Every edge endpoint must resolve to an existing concept record; a dangling endpoint is a validation error (exit 3), not a warning.",
  "type": "object",
  "required": ["schema_version", "subject_id", "updated_at", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject_id": {"type": "string", "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id"],
        "additionalProperties": false,
        "properties": {
          "concept_id": {"$ref": "#/$defs/concept_id"},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Directed edges. For `prerequisite`, `from` must be learned before `to`. Cross-subject prerequisites are allowed and use the other subject's prefix.",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "additionalProperties": false,
        "properties": {
          "from": {"$ref": "#/$defs/concept_id"},
          "to": {"$ref": "#/$defs/concept_id"},
          "type": {
            "type": "string",
            "enum": ["prerequisite", "related", "applies-to"]
          },
          "note": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "concept_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
