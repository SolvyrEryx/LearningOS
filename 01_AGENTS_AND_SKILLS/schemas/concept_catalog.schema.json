{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learningos.local/schemas/concept_catalog.schema.json",
  "title": "Concept catalogue",
  "description": "02_KNOWLEDGE/subjects/<subject_id>/concept_catalog.json — the machine-readable list of what this subject contains. It is knowledge, not state: no mastery, no evidence, no timestamps of attempts. init-subject never merges into an existing catalogue, so entries cannot be duplicated.",
  "type": "object",
  "required": ["schema_version", "subject_id", "updated_at", "concepts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject_id": {"type": "string", "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "concepts": {
      "type": "array",
      "description": "One entry per concept the learner must be able to do something with. Prefer concepts testable in a single question.",
      "items": {
        "type": "object",
        "required": ["concept_id", "name"],
        "additionalProperties": false,
        "properties": {
          "concept_id": {"$ref": "#/$defs/concept_id"},
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": ["string", "null"]},
          "description": {
            "type": ["string", "null"],
            "description": "One line: what the learner must be able to do."
          },
          "prerequisite_ids": {
            "type": "array",
            "items": {"$ref": "#/$defs/concept_id"}
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id"],
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "locator": {"type": ["object", "null"]},
                "note": {"type": ["string", "null"]}
              }
            }
          },
          "exam_weight": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "concept_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
