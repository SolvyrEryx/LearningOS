{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learningos.local/schemas/workspace_state.schema.json",
  "title": "Workspace state",
  "description": "03_MEMORY/global/workspace_state.json — the machine-readable registry of subjects plus the pointer to whatever is currently active. This exists so that `resume` and `status` do not have to guess which subject the learner meant by scanning directories.",
  "type": "object",
  "required": ["schema_version", "updated_at", "subjects"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "current_subject_id": {
      "type": ["string", "null"],
      "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$"
    },
    "last_session_id": {"type": ["string", "null"]},
    "last_session_at": {"$ref": "#/$defs/timestamp_or_null"},
    "last_backup_id": {"type": ["string", "null"]},
    "tool_version": {"type": ["string", "null"]},
    "subjects": {
      "type": "array",
      "description": "One entry per initialised subject. The authoritative list; directories are the fallback.",
      "items": {
        "type": "object",
        "required": ["subject_id", "name", "created_at"],
        "additionalProperties": false,
        "properties": {
          "subject_id": {"type": "string", "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$"},
          "name": {"type": "string", "minLength": 1},
          "created_at": {"$ref": "#/$defs/timestamp"},
          "exam_date": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "last_session_at": {"$ref": "#/$defs/timestamp_or_null"},
          "knowledge_path": {"$ref": "#/$defs/relative_path"},
          "memory_path": {"$ref": "#/$defs/relative_path"}
        }
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^[^/\\\\:][^\\\\:]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "timestamp_or_null": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
