{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learningos.local/schemas/subject_config.schema.json",
  "title": "Subject config",
  "description": "02_KNOWLEDGE/subjects/<subject_id>/subject_config.json — the knowledge-side identity of a subject: what it is, how it is examined, and how its material is organised. Learner state never appears here.",
  "type": "object",
  "required": ["schema_version", "subject_id", "name", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject_id": {
      "type": "string",
      "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$",
      "description": "Equals the directory name and prefixes every concept id in this subject. The single reserved value `_template` is permitted so the shipped templates validate as written; `init-subject` rejects it as user input."
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "exam_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "exam_format": {
      "type": ["string", "null"],
      "description": "Free text, e.g. '3 h written, 5 of 7 questions, calculator allowed'."
    },
    "language": {"type": ["string", "null"]},
    "notation_preferences": {
      "type": "array",
      "description": "Notation the learner's course uses, so explanations match their material.",
      "items": {"type": "string", "minLength": 1}
    },
    "units": {
      "type": "array",
      "description": "Syllabus units in teaching order.",
      "items": {
        "type": "object",
        "required": ["unit_id", "title"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "title": {"type": "string", "minLength": 1},
          "weighting": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Share of the exam, 0..1, when known."
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id"],
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "locator": {"type": ["object", "null"]},
                "note": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
