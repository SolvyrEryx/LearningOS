{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learningos.local/schemas/misconceptions.schema.json",
  "title": "Misconceptions",
  "description": "03_MEMORY/subjects/<subject_id>/misconceptions.json — named wrong models, their detection signals and their remediation. A misconception is a first-class record because the same wrong model resurfaces across concepts and sessions; reuse an existing record rather than creating a near-duplicate.",
  "type": "object",
  "required": ["schema_version", "subject_id", "updated_at", "misconceptions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject_id": {"type": "string", "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["misconception_id", "description", "status", "first_seen_at"],
        "additionalProperties": false,
        "properties": {
          "misconception_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*:mc-[0-9]{3}$",
            "description": "<subject_id>:mc-NNN, zero-padded to three digits."
          },
          "concept_ids": {
            "type": "array",
            "items": {"$ref": "#/$defs/concept_id"}
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "The wrong model, stated plainly."
          },
          "learner_statement_example": {
            "type": ["string", "null"],
            "description": "What the learner actually said, so the signal is recognisable next time."
          },
          "correct_statement": {"type": ["string", "null"]},
          "detection_signals": {
            "type": "array",
            "description": "Observable cues that this misconception is active.",
            "items": {"type": "string", "minLength": 1}
          },
          "remediation": {
            "type": "array",
            "description": "Steps that confronted it successfully, in order.",
            "items": {"type": "string", "minLength": 1}
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at"],
              "additionalProperties": false,
              "properties": {
                "at": {"$ref": "#/$defs/timestamp"},
                "session_id": {"type": ["string", "null"]},
                "event_id": {"type": ["string", "null"]},
                "concept_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"}
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["open", "monitoring", "resolved"],
            "description": "open: active. monitoring: confronted once, awaiting a second clean trigger. resolved: independent success on a trigger item."
          },
          "first_seen_at": {"$ref": "#/$defs/timestamp"},
          "last_seen_at": {"$ref": "#/$defs/timestamp_or_null"},
          "resolved_at": {"$ref": "#/$defs/timestamp_or_null"}
        }
      }
    }
  },
  "$defs": {
    "concept_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "timestamp_or_null": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
