{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learningos.local/schemas/revision_queue.schema.json",
  "title": "Revision queue",
  "description": "03_MEMORY/subjects/<subject_id>/revision_queue.json — what is due and when. Interval ladder in days: 1, 3, 7, 16, 35. independent_success advances one step; hinted_success holds; partial and fail reset to step 0. This file is derived state: if it is lost it can be rebuilt from the concept records, so a missing file is a warning rather than an error.",
  "type": "object",
  "required": ["schema_version", "subject_id", "updated_at", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject_id": {"type": "string", "pattern": "^(_template|[a-z0-9][a-z0-9_-]*)$"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "ladder_days": {
      "type": "array",
      "description": "The interval ladder in use. Defaults to [1, 3, 7, 16, 35]; past the last step the interval holds.",
      "items": {"type": "integer", "minimum": 1}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "due_at", "interval_days", "step_index"],
        "additionalProperties": false,
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
          },
          "due_at": {"$ref": "#/$defs/timestamp"},
          "interval_days": {"type": "integer", "minimum": 0},
          "step_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Index into ladder_days."
          },
          "reason": {
            "type": ["string", "null"],
            "description": "Why this is queued: spacing, needs_review, misconception trigger, promotion gate."
          },
          "last_outcome": {
            "type": ["string", "null"],
            "enum": ["independent_success", "hinted_success", "partial", "fail", null]
          },
          "attempts": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
